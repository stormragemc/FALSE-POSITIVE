# =============================================================================
# Unity — from github/gitignore Unity.gitignore (CC0-1.0), synced 2025-12-18
# https://github.com/github/gitignore/blob/main/Unity.gitignore
# =============================================================================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender intermediate files
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# =============================================================================
# Secrets — the challenge brief explicitly prohibits committing credentials (G2)
# =============================================================================
.env
.env.*
!.env.example
**/.env
Sidecar/.env
*.pem
*.key

# =============================================================================
# Python / sidecar
# =============================================================================
.venv/
venv/
Sidecar/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc

# =============================================================================
# Node / web tooling (unused today, kept for future service work)
# =============================================================================
node_modules/
dist/
out/
.next/
*.tsbuildinfo

# =============================================================================
# Model weights & large local artefacts
# HuBERT and Whisper checkpoints download to the HuggingFace cache outside the
# repo. These patterns catch a checkpoint accidentally copied in.
# NOTE: bare "*.bin" is deliberately NOT listed — it is ambiguous inside a Unity
# project. The explicit ML formats below are unambiguous.
# =============================================================================
*.pt
*.onnx
*.safetensors
models/
.cache/

# =============================================================================
# Voice captures — never commit a recording of a real person (G2)
# Game audio under Assets/ is authored content, not a capture, so it is exempt.
# =============================================================================
recordings/
/[Rr]ecordings/
*.wav
*.mp3
*.m4a
!Assets/**/*.wav
!Assets/**/*.mp3
!docs/assets/**

# =============================================================================
# Editors & OS
# =============================================================================
.gstack/
.DS_Store
.vscode/
.idea/
coverage/
