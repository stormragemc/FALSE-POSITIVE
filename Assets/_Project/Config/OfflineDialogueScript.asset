  m_Script: {fileID: 11500000, guid: 9c844a562016cd549bd28f375e6b1933, type: 3}
  m_Name: OfflineDialogueScript
  m_EditorClassIdentifier: FalsePositive.Runtime::FalsePositive.Dialogue.OfflineDialogueScript
  p2Recall:
  - line: So. What's the last thing you remember?
    voClip: {fileID: 8300000, guid: 9ac6e36e98cf2f341854c78099448146, type: 3}
    holdSecondsIfNoClip: 4
  - line: Who else was drinking with you?
    voClip: {fileID: 8300000, guid: 21f2d3903055bfe4d95f5ff409745b1e, type: 3}
    holdSecondsIfNoClip: 3
  - line: How much did you have?
    voClip: {fileID: 8300000, guid: e8894558afc1ca247b2cab133666032a, type: 3}
    holdSecondsIfNoClip: 3
  - line: Tell me about the argument with Nick. What was it really about?
    voClip: {fileID: 8300000, guid: 688ae5f5ef9de544fa6073d29fe7c007, type: 3}
    holdSecondsIfNoClip: 4
  - line: What did Nick do after the argument?
    voClip: {fileID: 8300000, guid: 8f59363e86c32ea42897a1f27b948a8e, type: 3}
    holdSecondsIfNoClip: 3
  - line: What did you do next?
    voClip: {fileID: 8300000, guid: 4de312267c34e614a8209ddd5c6d6e02, type: 3}
    holdSecondsIfNoClip: 3
  - line: Was the door locked when you opened it?
    voClip: {fileID: 8300000, guid: 4fc9710ec748cad4ba626f86dfb8c3ad, type: 3}
    holdSecondsIfNoClip: 3
  - line: Walk me through the morning. Start with Priya's scream.
    voClip: {fileID: 8300000, guid: 7645ca6d1b6660d45aef47d8715fd91b, type: 3}
    holdSecondsIfNoClip: 4
  - line: What happened to Nick?
    voClip: {fileID: 8300000, guid: dd1e2f7419ccb7f49b9558192ca903da, type: 3}
    holdSecondsIfNoClip: 3
  p3Verdict:
  - line: Tell me why I should spare your life.
    voClip: {fileID: 8300000, guid: fd08976b4c66682438d1e4ace3adf0f9, type: 3}
    holdSecondsIfNoClip: 4
  - line: If it's not you, then tell me who did it.
    voClip: {fileID: 8300000, guid: e154d106ff6d3524f8eba05c9a6884e1, type: 3}
    holdSecondsIfNoClip: 4
  - line: That's not an answer. Try again.
    voClip: {fileID: 8300000, guid: b9540096c2e9646438f469403e446505, type: 3}
    holdSecondsIfNoClip: 3
  - line: You understand how that sounds, don't you?
    voClip: {fileID: 8300000, guid: ab0e2ece830ed80428cf471bc91f3906, type: 3}
    holdSecondsIfNoClip: 3.5
  - line: Last chance. Who do you think did this?
    voClip: {fileID: 8300000, guid: 1cdd2cd987ad5244dac29356d843e457, type: 3}
    holdSecondsIfNoClip: 3.5
