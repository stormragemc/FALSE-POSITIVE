      voClip: {fileID: 0}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: Not tonight, David. I can't do this with you right now. I need some air.
      voClip: {fileID: 8300000, guid: 88814af1b2d9950419c8d640bb829119, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 3
    fadeOutSeconds: 1.2
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: 372b7593d2de48a488c72d1bdeb65f53, type: 3}
      holdSecondsIfNoClip: 1.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 1
  - id: 4
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: be4b25939d31a964cb860276b1d7ecec, type: 3}
      holdSecondsIfNoClip: 0.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: 
      line: 
      voClip: {fileID: 0}
