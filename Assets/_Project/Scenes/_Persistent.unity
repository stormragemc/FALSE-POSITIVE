  - id: 18
    fadeOutSeconds: 0.5
    fadeInSeconds: 0.5
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: b889e8ceacf8cc24188dd979e352edcf, type: 3}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
