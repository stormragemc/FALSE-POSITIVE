    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 3.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: RADIO
      line: A snowstorm is moving through the area. Please stay indoors until conditions
        improve.
      voClip: {fileID: 8300000, guid: bc6dd67568004594490737b75528a7e8, type: 3}
      holdSecondsIfNoClip: 3
      memoryFlagToSet: heard_radio_warning
