      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 7
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: 4ec852397533e3f40ba452263b625ca6, type: 3}
      holdSecondsIfNoClip: 1.8
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 8
    fadeOutSeconds: 1.2
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 0.9
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 1
  - id: 9
    fadeOutSeconds: 1.2
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 0.9
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 1
  - id: 10
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: PRIYA
      line: Guys! Help! Something's happened to Nick! Ivy! Aaron! David! Please,
        come here!
      voClip: {fileID: 8300000, guid: 5db3393beb6de4040b0456087ca248c3, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: saw_body
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 11
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: cb7d98da1477b004c8f04adf9c195dbc, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 12
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: PRIYA
      line: What do we do? What do we do?
      voClip: {fileID: 8300000, guid: 442abb0aeae5a3b4c8d4b2012f2bed64, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: IVY
      line: Oh my God. What happened to him? What do we do now?
      voClip: {fileID: 8300000, guid: 284ef2dd320a3b7448e8af5100c21461, type: 3}
      holdSecondsIfNoClip: 2.5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: AARON
      line: He's freezing. Let's get him inside, onto the sofa by the fire.
      voClip: {fileID: 8300000, guid: 8f7d022510ada414ba33fef452331c98, type: 3}
      holdSecondsIfNoClip: 3
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 13
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: PRIYA
      line: How did this happen?
      voClip: {fileID: 8300000, guid: 7816ef5271895e24bae392d31eac9efe, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: IVY
      line: I don't know. I was upstairs with Aaron.
      voClip: {fileID: 8300000, guid: 8fb2fb288b1610e4980579ed9cf79c2f, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: All night?
      voClip: {fileID: 8300000, guid: aa95efdeb37a462439676facd01a886b, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: IVY
      line: Yes. All night.
      voClip: {fileID: 8300000, guid: a24840ffebe692c4b83577790941e541, type: 3}
      holdSecondsIfNoClip: 1.5
      memoryFlagToSet: heard_ivy_alibi
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: AARON
      line: Priya. Not now.
      voClip: {fileID: 8300000, guid: ce4feecfb0dbcac4c9c6e8a097ab4c8a, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: The door was locked. Who locked it?
      voClip: {fileID: 8300000, guid: 6dadc20b40cfcfd43968a91a857f9fff, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: AARON
      line: Lift on three. One, two, three.
      voClip: {fileID: 8300000, guid: 259935d3e97dcfe41a7e8f7bae605ff0, type: 3}
      holdSecondsIfNoClip: 1.5
      memoryFlagToSet: heard_aaron_deflect
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 14
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: 9e24a7ab08548ad40843da3426149308, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: Nick? Nick, can you hear me?
      voClip: {fileID: 8300000, guid: 016f23873980f604ba9bba7c7900fd71, type: 3}
      holdSecondsIfNoClip: 2.5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: Police? Our friend is hurt. We found him outside in the snow. Please
        send someone. Please hurry.
      voClip: {fileID: 8300000, guid: e50e43787e6ac124c8708db2cf962e9e, type: 3}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 15
    fadeOutSeconds: 1.2
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 0.9
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 1
  - id: 25
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: SPASSKY
      line: That's what I don't understand.
      voClip: {fileID: 8300000, guid: e0052a02bb1b7e349a2d7fcdd4faca53, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: SPASSKY
      line: Old friends. An anniversary. Drinks. From the way they tell it, things
        were going well.
      voClip: {fileID: 8300000, guid: 1bf3529d3885b914d8802f27d172760e, type: 3}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: SPASSKY
      line: So when did it all go wrong?
      voClip: {fileID: 8300000, guid: df80c21e31500f84f96c45004768ca62, type: 3}
      holdSecondsIfNoClip: 2.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 26
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: SPASSKY
      line: And somewhere between that photograph and sunrise, Nick ended up dead.
      voClip: {fileID: 8300000, guid: f980d403ac4d44a419f340f410f71b68, type: 3}
      holdSecondsIfNoClip: 4.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: SPASSKY
      line: "If it wasn't you, David \u2014 who killed Nick?"
      voClip: {fileID: 8300000, guid: 99509256ab87cdb4abcb9837b5daa125, type: 3}
      holdSecondsIfNoClip: 3
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 27
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: SPASSKY
      line: Who, David?
      voClip: {fileID: 8300000, guid: 1920efa8ec5e91544aae187001255fc8, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 23
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: PRIYA
      line: Fifteen years and you two still act exactly the same.
      voClip: {fileID: 8300000, guid: 878a042caff1c59408258b6b609d8992, type: 3}
      holdSecondsIfNoClip: 2.4
      memoryFlagToSet: 
      timeCard: 21:00
      timeCardCaption: Earlier that night
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: He was worse at seventeen.
      voClip: {fileID: 8300000, guid: bc2f22b392c454e42bdb560544547fcf, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: And two years for these two.
      voClip: {fileID: 8300000, guid: f9aa7945196ac7f4281a1a2ed3bce094, type: 3}
      holdSecondsIfNoClip: 1.8
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: AARON
      line: Barely survived it.
      voClip: {fileID: 8300000, guid: 28a1dc9177f7aae439502601213277dc, type: 3}
      holdSecondsIfNoClip: 1.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: PRIYA
      line: To us. Somehow.
      voClip: {fileID: 8300000, guid: f77503260e8c53b4c818de1952557e09, type: 3}
      holdSecondsIfNoClip: 1.4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: Unfortunately.
      voClip: {fileID: 8300000, guid: 0aa14e2b9f3f3044391d39548b2060b2, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: Here. You look fucking freezing.
      voClip: {fileID: 8300000, guid: b89da88d5321bec4e842874e9a146654, type: 3}
      holdSecondsIfNoClip: 2
      memoryFlagToSet: saw_coat_swap
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 24
    fadeOutSeconds: 0
    fadeInSeconds: 0
    beats:
    - speaker: RADIO
      line: "\u2026snow storm\u2026"
      voClip: {fileID: 8300000, guid: fd1799031418ff846bfad8550a443345, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 23:40
      timeCardCaption: Later. The fire is dying.
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: You've been saying "after this trip" for two years.
      voClip: {fileID: 8300000, guid: 7c4cce49e81814641b46721803e25fa1, type: 3}
      holdSecondsIfNoClip: 2.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: AARON
      line: "\u2026Two years?"
      voClip: {fileID: 8300000, guid: 9afcbedd9f050bf4989d5f4663bccee1, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: saw_aaron_learn
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: RADIO
      line: "\u2026please stay indoors\u2026"
      voClip: {fileID: 8300000, guid: 92b125739a7923348b3b42e36d562624, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: DAVID
      line: You need to tell him.
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 1.8
      memoryFlagToSet: 
      timeCard: 00:50
      timeCardCaption: "About an hour later \u2014 David and Nick, alone"
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: He already knows.
      voClip: {fileID: 8300000, guid: 13778a44715267b46ada1dcd4c19f814, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: DAVID
      line: Then say it to his face.
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 1.8
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: NICK
      line: I need some air.
      voClip: {fileID: 8300000, guid: d4378fca1e1749d4abea651a51db4002, type: 3}
      holdSecondsIfNoClip: 1.6
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: RADIO
      line: "\u2026during these times."
      voClip: {fileID: 8300000, guid: 2b33df65828a2b046aee5d6ae7452e94, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: e2ae14da0ef5a2249b94aebb278e139c, type: 3}
      holdSecondsIfNoClip: 1.2
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 1
    endsBlack: 0
  - id: 16
    fadeOutSeconds: 0.5
    fadeInSeconds: 0.5
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: d43819e8d09e10d49b7b4b314b64cfcf, type: 3}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 17
    fadeOutSeconds: 0.5
    fadeInSeconds: 0.5
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 18
    fadeOutSeconds: 0.5
    fadeInSeconds: 0.5
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 8300000, guid: b889e8ceacf8cc24188dd979e352edcf, type: 3}
      holdSecondsIfNoClip: 5
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 19
    fadeOutSeconds: 0.4
    fadeInSeconds: 0.6
    beats:
    - speaker: SPASSKY
      line: You were the only one who couldn't tell me where you were.
      voClip: {fileID: 8300000, guid: 87ffdc5696bddd94d9f1136bf011167e, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 20
    fadeOutSeconds: 0.4
    fadeInSeconds: 0.6
    beats:
    - speaker: SPASSKY
      line: He locked it. You unlocked it. Only one of those was a decision.
      voClip: {fileID: 8300000, guid: 015d4e17bbcdb7c4fb50145c5c4046e5, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 21
    fadeOutSeconds: 0.4
    fadeInSeconds: 0.6
    beats:
    - speaker: SPASSKY
      line: She agreed with you. That's not the same as it being true.
      voClip: {fileID: 8300000, guid: 00e14b952a060f44089fcdd61356d050, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
  - id: 22
    fadeOutSeconds: 0.4
    fadeInSeconds: 0.6
    beats:
    - speaker: PRIYA
      line: What happened? Why won't anyone tell me what happened?
      voClip: {fileID: 8300000, guid: 022dd58b00e564944acfe13fa7f2ff03, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    - speaker: SPASSKY
      line: She's the one who called us. Sit with that.
      voClip: {fileID: 8300000, guid: f00b0c3143a76b24d842e57f11cb9284, type: 3}
      holdSecondsIfNoClip: 4
      memoryFlagToSet: 
      timeCard: 
      timeCardCaption: 
      timeCardHoldSeconds: 3.5
      dipToBlackBefore: 0
    keepScreenLit: 0
    endsBlack: 0
