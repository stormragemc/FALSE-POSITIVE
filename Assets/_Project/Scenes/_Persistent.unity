  - id: 9
    fadeOutSeconds: 1.2
    fadeInSeconds: 0
    beats:
    - speaker: 
      line: 
      voClip: {fileID: 0}
      holdSecondsIfNoClip: 0.9
      memoryFlagToSet: 
