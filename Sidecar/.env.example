# Copy this file to ".env" (same folder) and fill in your own values.
# Sidecar/.env is gitignored — never commit real keys.

# Google Cloud project that bills Vertex AI (Gemini) and Speech-to-Text.
# Both authenticate via Application Default Credentials — no API key.
# Locally: gcloud auth application-default login
GCP_PROJECT=
GCP_LOCATION=global
GCP_PROJECT=
GCP_LOCATION=
# elevenlabs.io — the free tier is testing-only (~10k chars/month); a paid
# plan (Starter or above) is realistically needed for actual play.
ELEVENLABS_API_KEY=

# Pick any stock voice from your ElevenLabs voice library and paste its ID
# here (no voice cloning needed for v1).
ELEVENLABS_VOICE_ID=

# Shared secret the Unity build sends as X-FP-Client-Key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FP_CLIENT_KEY=

# Optional overrides — defaults shown.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765

# Optional HuBERT affect-orchestration controls.
PROSODY_ENABLED=true
HUBERT_MODEL_ID=superb/hubert-base-superb-er
HUBERT_DEVICE=auto
HUBERT_HIDDEN_LAYER=9
HUBERT_MAX_SECONDS=20
PROSODY_BASELINE_TURNS=3
# Clamped to 0.75, the maximum conservative signal confidence.
PROSODY_MIN_CONFIDENCE=0.40
SIDECAR_MAX_AUDIO_SECONDS=30
SIDECAR_MAX_SESSIONS=32

# Cost ceiling. A turn spends Google STT + Vertex + ElevenLabs, so these are
# budget controls, not gameplay tuning.
MAX_TURNS_PER_SESSION=40
MAX_TURNS_PER_DAY=2000

# Network deadlines for the Google providers. A timeout fails the current turn
# instead of letting a stalled request hold the session open indefinitely.
SIDECAR_STT_TIMEOUT_SECONDS=20
SIDECAR_LLM_TIMEOUT_SECONDS=20
