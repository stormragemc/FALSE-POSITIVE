# Copy this file to ".env" (same folder) and fill in your own values.
# Sidecar/.env is gitignored — never commit real keys.

# Google Cloud project that bills Vertex AI (Gemini) and Speech-to-Text.
# Both authenticate via Application Default Credentials — no API key.
# Locally: gcloud auth application-default login
GCP_PROJECT=
GCP_LOCATION=global

# elevenlabs.io — the free tier is testing-only (~10k chars/month); a paid
# plan (Starter or above) is realistically needed for actual play.
ELEVENLABS_API_KEY=

# Pick any stock voice from your ElevenLabs voice library and paste its ID
# here (no voice cloning needed for v1).
ELEVENLABS_VOICE_ID=

# Shared key sent by the Unity client. Generate a long random value for deploys.
FP_CLIENT_KEY=

# Cost controls. These counters assume Cloud Run stays pinned to one instance.
MAX_TURNS_PER_SESSION=40
MAX_TURNS_PER_DAY=2000

# Optional server overrides — Cloud Run injects PORT automatically.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080

# Optional HuBERT affect-orchestration controls.
PROSODY_ENABLED=true
HUBERT_MODEL_ID=superb/hubert-base-superb-er
HUBERT_MODEL_REVISION=9a456581e0147a2b7fdaf56d77a9e8fce3865eaa
# Containers set this true after baking the pinned snapshot. Leave false for a
# first local Python run so Transformers can populate the developer cache.
HUBERT_LOCAL_FILES_ONLY=false
HUBERT_DEVICE=auto
HUBERT_HIDDEN_LAYER=9
HUBERT_MAX_SECONDS=20
PROSODY_BASELINE_TURNS=3
# Clamped to 0.75, the maximum conservative signal confidence.
PROSODY_MIN_CONFIDENCE=0.40
SIDECAR_MAX_AUDIO_SECONDS=20
SIDECAR_MAX_SESSIONS=32
# Read and cap the whole multipart body before FastAPI can spool an UploadFile.
MAX_TURN_REQUEST_BYTES=700000
# Session text/affect expires after one idle hour. Each turn has a server-side
# deadline shorter than Unity's 60-second request timeout.
SESSION_IDLE_TTL_SECONDS=3600
TURN_DEADLINE_SECONDS=50
