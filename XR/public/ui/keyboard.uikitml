<style>
.root { width: 84; flex-direction: column; padding: 2; gap: 1; background-color: #182226; border-radius: 1; }
.row { flex-direction: row; gap: .6; justify-content: center; }
.key { width: 6.8; height: 6.5; justify-content: center; align-items: center; background-color: #3b5054; border-radius: .5; }
.wide { width: 18; }
.label { color: #f4eee0; font-size: 2.5; }
.text { color: #f4eee0; font-size: 2; height: 11; }
</style>
<div class="root"><div id="draft-text" class="text">Your statement...</div>
<div class="row"><button id="key-Q" class="key"><div class="label">Q</div></button><button id="key-W" class="key"><div class="label">W</div></button><button id="key-E" class="key"><div class="label">E</div></button><button id="key-R" class="key"><div class="label">R</div></button><button id="key-T" class="key"><div class="label">T</div></button><button id="key-Y" class="key"><div class="label">Y</div></button><button id="key-U" class="key"><div class="label">U</div></button><button id="key-I" class="key"><div class="label">I</div></button><button id="key-O" class="key"><div class="label">O</div></button><button id="key-P" class="key"><div class="label">P</div></button></div>
<div class="row"><button id="key-A" class="key"><div class="label">A</div></button><button id="key-S" class="key"><div class="label">S</div></button><button id="key-D" class="key"><div class="label">D</div></button><button id="key-F" class="key"><div class="label">F</div></button><button id="key-G" class="key"><div class="label">G</div></button><button id="key-H" class="key"><div class="label">H</div></button><button id="key-J" class="key"><div class="label">J</div></button><button id="key-K" class="key"><div class="label">K</div></button><button id="key-L" class="key"><div class="label">L</div></button></div>
<div class="row"><button id="key-Z" class="key"><div class="label">Z</div></button><button id="key-X" class="key"><div class="label">X</div></button><button id="key-C" class="key"><div class="label">C</div></button><button id="key-V" class="key"><div class="label">V</div></button><button id="key-B" class="key"><div class="label">B</div></button><button id="key-N" class="key"><div class="label">N</div></button><button id="key-M" class="key"><div class="label">M</div></button><button id="key-period" class="key"><div class="label">.</div></button><button id="key-comma" class="key"><div class="label">,</div></button><button id="key-question" class="key"><div class="label">?</div></button></div>
<div class="row"><button id="key-space" class="key wide"><div class="label">Space</div></button><button id="key-back" class="key wide"><div class="label">Delete</div></button><button id="key-send" class="key wide"><div class="label">Send</div></button><button id="key-cancel" class="key wide"><div class="label">Back</div></button></div></div>
